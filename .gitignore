# The global gitignore excludes docs/, but this project's docs are committed:
# they carry the error budget, the interface reference and the figures.
!docs/

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Example imagery is fetched, never committed. Some of it we could ship --
# Copernicus permits it -- but not all of it, and megabytes of binary do not
# belong here either way. scripts/fetch_images.py downloads it and writes
# examples/images/MANIFEST.yaml. The point files are hand-made and tracked: they
# are the labelling, not the pixels, and they are useless if a re-fetch loses them.
examples/images/*
!examples/images/MANIFEST.yaml
!examples/images/*.points.yaml

# Rendered by scripts/project_points.py from the imagery above, so it inherits
# the same reason for staying out.
output/
