# The global gitignore excludes docs/, but this project's docs are committed:
# they carry the error budget, the interface reference and the figures.
!docs/

__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Example imagery is fetched, never committed: the licences are not ours to
# redistribute under. examples/images/MANIFEST.yaml records where each file
# came from and is the only thing in there that is tracked.
examples/images/*
!examples/images/MANIFEST.yaml
